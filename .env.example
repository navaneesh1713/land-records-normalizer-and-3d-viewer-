# Optional: Your Mapbox Public Access Token (starts with pk.)
# If left blank, the viewer seamlessly falls back to high-resolution Carto GL vector tiles.
VITE_MAPBOX_TOKEN=

# Gemini API Key for Handwritten & Cursive Land Records Vision OCR (Google AI Studio)
VITE_GEMINI_API_KEY=
# Gemini Vision Model (e.g. gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, gemini-2.5-pro)
VITE_GEMINI_MODEL=gemini-2.5-flash
